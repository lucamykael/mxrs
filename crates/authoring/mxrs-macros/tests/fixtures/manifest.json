{
  "modules": [
    {
      "name": "Sales",
      "entities": [
        { "name": "Customer", "attributes": ["Name"] },
        {
          "name": "Order",
          "attributes": ["Number", "Total"],
          "associations": [
            { "name": "Order_Customer", "target": "Customer", "type": "Reference" },
            { "name": "Order_Account", "target": "CRM.Account", "type": "Reference" }
          ]
        }
      ]
    },
    {
      "name": "CRM",
      "entities": [{ "name": "Account", "attributes": ["Name"] }]
    }
  ]
}
